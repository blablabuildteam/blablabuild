# Copy to .env.local and fill in your values. Never commit .env.local or .env.vercel.

# Gemini AI (required for chat)
GEMINI_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# Neon Postgres (site insights)
DATABASE_URL=

# Supabase (chat/session storage if used)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (optional)
RESEND_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: site password gate (also used for /insights)
AUTH_TOKEN=
SITE_PASSWORD=
